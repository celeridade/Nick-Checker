# ---> L96A1 web — copie para .env (nunca commitar o .env real)
# Local: docker compose up --build | VPS Oracle: mesmos valores via secrets

# Postgres (compose cria pgdata)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Portas locais
API_PORT=8080
WEB_PORT=3000

# Motor Rust (l96a1-api) — espelha l96a1.toml sem vazar secrets
RUST_LOG=info
TIMEOUT_SECS=10
MAX_CONCURRENT=100
THROTTLE_BATCH_SIZE=0
THROTTLE_DELAY_SECS=30

# Tokens (vazios por padrão; preencha no .env local, nunca no repo)
GITHUB_TOKEN=
DISCORD_TOKEN=
DISCORD_TOKENS=
# Sessões TikTok logadas (uma cookie-string por linha; cookies têm `;`,
# então aqui o separador é quebra de linha). Alternativa: tiktok_sessions.txt
TIKTOK_SESSIONS=
WEBHOOK_URL=
WEBHOOK_MODE=batch
BOT_TOKEN=
BOT_GUILD_ID=
BOT_PREFIX=!

# Sniper 24h (equivale a `l9 snipe`; loop roda dentro da API)
SNIPE_INTERVAL_SECS=300
SNIPE_PLATFORMS=all
WATCHLIST_FILE=watchlist.txt

# Persistência do histórico (não reseta no restart)
HISTORY_FILE=history.json
CHECKED_FILE=checked.json

# Next BFF -> API Rust (compose usa http://api:8080; local sem docker usa http://127.0.0.1:8080)
L96A1_API_URL=http://127.0.0.1:8080

# Auth web (obrigatório p/ login; gere com: openssl rand -base64 32)
AUTH_SECRET=

# Billing (quando houver Stripe; sem isso o checkout roda em modo teste)
STRIPE_SECRET_KEY=
